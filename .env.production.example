# Guardian-IO Production Environment Configuration
# Copy this file to .env.production and fill in your actual values

# ============ Database Configuration ============
# PostgreSQL Connection Settings
DB_HOST=your-database-host.com
DB_PORT=5432
DB_USER=guardian_io_user
DB_PASSWORD=your-secure-password-here
DB_NAME=guardian_io_production

# Database SSL (optional, recommended for production)
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# ============ Server Configuration ============
# Node.js Environment
NODE_ENV=production
PORT=3000

# API Configuration
API_URL=https://api.guardian-io.com
API_TIMEOUT=30000

# ============ WebSocket Configuration ============
# WebSocket Server Settings
WEBSOCKET_URL=wss://ws.guardian-io.com
WEBSOCKET_PORT=8080
WEBSOCKET_ENABLE_SSL=true

# Redis Configuration (for WebSocket message queue)
REDIS_HOST=your-redis-host.com
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# ============ Authentication & Security ============
# JWT Configuration
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRATION=7d

# OAuth Configuration (if using social login)
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============ File Storage ============
# S3 Configuration for file uploads
S3_BUCKET=guardian-io-production
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_ENDPOINT=https://s3.amazonaws.com

# ============ Email Configuration ============
# SMTP Settings for notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@guardian-io.com

# ============ Logging & Monitoring ============
# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Sentry Configuration (error tracking)
SENTRY_DSN=your-sentry-dsn-url

# ============ Feature Flags ============
# Feature Toggle Configuration
ENABLE_REAL_TIME_SYNC=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_SOCIAL_SHARING=true
ENABLE_PDF_EXPORT=true

# ============ Rate Limiting ============
# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============ Notification Services ============
# Firebase Cloud Messaging (for push notifications)
FCM_PROJECT_ID=your-fcm-project-id
FCM_PRIVATE_KEY=your-fcm-private-key
FCM_CLIENT_EMAIL=your-fcm-client-email

# ============ Analytics ============
# Google Analytics Configuration
GOOGLE_ANALYTICS_ID=your-ga-id

# ============ Application Settings ============
# App Configuration
APP_NAME=Guardian-IO
APP_VERSION=1.0.0
APP_ENVIRONMENT=production

# Support & Contact
SUPPORT_EMAIL=support@guardian-io.com
CONTACT_PHONE=+1-800-GUARDIAN
